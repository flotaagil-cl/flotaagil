# Copia este archivo como .env (no se versiona). Valores solo para desarrollo local.

DJANGO_SECRET_KEY=cambia-esta-clave-solo-para-desarrollo
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ruta del admin de mantenimiento interno.
DJANGO_ADMIN_URL=admin/

# Servicios del docker-compose de desarrollo (infra/docker-compose.dev.yml).
DATABASE_URL=postgis://flotaagil:flotaagil-dev@db:5432/flotaagil
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Duración de los tokens (minutos / horas).
JWT_ACCESS_MIN=15
JWT_REFRESH_HORAS=12
# Contraseña temporal de un conductor (la genera el administrador): vence si no se cambia en este plazo.
PASSWORD_TEMPORAL_HORAS=72
# En producción la cookie del refresh debe ser Secure; en desarrollo (http) no.
JWT_COOKIE_SECURE=false

# Duración máxima de la sesión del panel desde el login, aunque se renueve (horas).
JWT_SESION_MAX_HORAS=12
# Orígenes permitidos para login, refresh y logout del panel (separados por coma, sin barra final).
# Desarrollo: Vite y Swagger. Producción: solo el https público, p. ej. https://panel.flotaagil.example
PANEL_ORIGENES=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Bloqueo tras 5 intentos fallidos (USUARIO.intentos_fallidos): duración en minutos.
LOGIN_BLOQUEO_MIN=15

# Link del convenio (HU-25): intentos, minutos de bloqueo y minutos de la sesión sin uso.
CONVENIO_MAX_INTENTOS=5
CONVENIO_BLOQUEO_MIN=15
CONVENIO_SESION_MIN=120

# Throttling por IP (login y portal público). El del portal es holgado: con el wifi del aeropuerto muchos
# pasajeros comparten IP, y el control principal es el límite por teléfono (más abajo).
THROTTLE_LOGIN=10/min
THROTTLE_PORTAL_MINUTO=20/min
THROTTLE_PORTAL_HORA=200/hour
# Proxies delante de Django. Desarrollo: vacío. Producción: obligatorio 1 (exactamente un proxy, Nginx en EC2,
# sin balanceador). Ver «Producción detrás de Nginx» en backend/README.md.
DJANGO_NUM_PROXIES=

# Portal: máximo de solicitudes por teléfono y empresa en la ventana (RN-06).
PORTAL_MAX_SOLICITUDES_POR_TELEFONO=3
PORTAL_VENTANA_TELEFONO_MIN=15

# Geocodificador: vacío = coordenadas de desarrollo; con clave = Google Geocoding API.
GOOGLE_GEOCODING_API_KEY=
# Vuelos (HU-26): clave de FlightAware AeroAPI (con costo). Vacía = consultor de desarrollo (todo vuelo existe
# salvo los que empiezan con ZZ). AEROPUERTO_IATA: aeropuerto de llegada que se valida.
FLIGHTAWARE_API_KEY=
AEROPUERTO_IATA=SCL
# WhatsApp (HU-20) con Twilio (con costo). Vacías = notificador de desarrollo: registra los mensajes y las
# respuestas se simulan con `python manage.py simular_whatsapp <viaje> confirmar|cancelar`.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Sin plantilla (sandbox) la verificación va como texto. Ver docs/credenciales-externas.md.
TWILIO_PLANTILLA_VERIFICACION=
# Avisos de estado. Sin plantilla van como texto, que solo llega dentro de la ventana de 24 h.
TWILIO_PLANTILLA_AVISO_CONFIRMACION=
TWILIO_PLANTILLA_AVISO_CONDUCTOR=
TWILIO_PLANTILLA_AVISO_EN_CAMINO=
TWILIO_PLANTILLA_AVISO_EN_ZONA=
TWILIO_PLANTILLA_AVISO_ENCUESTA=
WHATSAPP_URL_BASE=

# Contraseña de los usuarios sintéticos del comando datos_demo.
DATOS_DEMO_PASSWORD=demo-flotaagil-2026

# HU-33: correo. consola (desarrollo) o ses (Amazon SES por SMTP, us-east-1). Sin credenciales en el repositorio.
CORREO_PROVEEDOR=consola
CORREO_REMITENTE=FlotaÁgil <no-responder@flotaagil.example>
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PUERTO=587
SES_SMTP_USUARIO=
SES_SMTP_CLAVE=
# HU-35: URL pública de la web (enlaces de los correos) y vigencia del enlace para recuperar la contraseña.
WEB_URL_BASE=http://localhost:5173
RECUPERAR_PASSWORD_HORAS=2
